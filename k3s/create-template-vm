#!/bin/bash

# create an ubuntu resolute (26.04) qm template
# 
# original idea from https://github.com/UntouchedWagons/Ubuntu-CloudInit-Docs

# find the node ordinal from the current hostname (pve, pve2, pve3)
node=$(hostname|perl -ne 'chomp;s/\D+//;print $_ ? $_ : 1')
# create a unique id for the template based on the node ordinal
vmid=${node}001
image_path=~/images
username=gerry

mkdir -p $image_path
pushd $image_path
wget -q https://cloud-images.ubuntu.com/resolute/current/resolute-server-cloudimg-amd64.img
qemu-img resize resolute-server-cloudimg-amd64.img 96G
popd

sudo qm list | grep -qP "^\s+$vmid\s" && sudo qm destroy $vmid

sudo qm create $vmid \
    --name "resolute-template" \
    --ostype l26 \
    --memory 4096 \
    --agent 1 \
    --bios ovmf \
    --machine q35 \
    --efidisk0 local-lvm:0,pre-enrolled-keys=0 \
    --cpu host \
    --socket 1 \
    --cores 2 \
    --vga serial0 --serial0 socket  \
    --net0 virtio,bridge=vmbr0

sudo qm importdisk $vmid $image_path/resolute-server-cloudimg-amd64.img local-lvm

sudo qm set $vmid \
  --scsihw virtio-scsi-pci \
  --virtio0 local-lvm:vm-$vmid-disk-1,discard=on \
  --boot order=virtio0 \
  --scsi1 local-lvm:cloudinit

sudo qm set $vmid \
  --cicustom "vendor=local:snippets/vendor.yaml" \
  --tags ubuntu-template,26.04,cloudinit \
  --ciuser $username \
  --sshkeys ~/.ssh/authorized_keys \
  --ipconfig0 ip=dhcp \

# shouldn't be a need for the user to have a known password but if so this can be used
# sudo qm set --cipassword $(openssl passwd -6 $CLEARTEXT_PASSWORD) \

sudo qm template $vmid 
